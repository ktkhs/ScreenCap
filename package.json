{
  "name": "screencap",
  "version": "1.0.0",
  "description": "Screen capture app for Windows/Mac",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "license": "ISC",
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "screenshot-desktop": "^1.15.4"
  },
  "build": {
    "appId": "com.screencap.app",
    "productName": "ScreenCap",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    }
  }
}
